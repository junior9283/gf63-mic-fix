#: src/gf63_mic_fix/diagnose.py:137
#, python-format
msgid "Could not record or play sound: %s"
msgstr "Não foi possível gravar ou tocar som: %s"

#: src/gf63_mic_fix/fix.py:45
msgid "This laptop is not an MSI GF63 Thin with a Realtek ALC233 codec."
msgstr "Este notebook não é um MSI GF63 Thin com codec Realtek ALC233."

#: src/gf63_mic_fix/fix.py:46
msgid "PipeWire is not the sound server. This fix needs PipeWire."
msgstr "O servidor de som não é o PipeWire. Esta correção precisa do PipeWire."

#: src/gf63_mic_fix/fix.py:47
#, python-format
msgid "PipeWire is too old. Version %s or newer is required."
msgstr "O PipeWire é antigo demais. É necessária a versão %s ou mais recente."

#: src/gf63_mic_fix/fix.py:49
msgid "Run the diagnosis first: this GF63 variant has not been verified yet."
msgstr ""
"Execute o diagnóstico antes: esta variante do GF63 ainda não foi verificada."

#: src/gf63_mic_fix/fix.py:76
#, python-format
msgid "Sound server command failed: %s"
msgstr "O comando do servidor de som falhou: %s"

#: src/gf63_mic_fix/fix.py:91
msgid "Could not read the microphone volume."
msgstr "Não foi possível ler o volume do microfone."

#: src/gf63_mic_fix/fix.py:105
msgid "The RNNoise noise suppression plugin is not installed."
msgstr "O plugin de supressão de ruído RNNoise não está instalado."

#: src/gf63_mic_fix/fix.py:111 src/gf63_mic_fix/ui/window.py:37
msgid "Internal microphone (fixed)"
msgstr "Microfone interno (corrigido)"

#: src/gf63_mic_fix/fix.py:128
msgid "The internal microphone was not found by the sound server."
msgstr "O servidor de som não encontrou o microfone interno."

#: src/gf63_mic_fix/fix.py:169
msgid "The fixed microphone did not start. Nothing was changed."
msgstr "O microfone corrigido não iniciou. Nada foi alterado."

#: src/gf63_mic_fix/fix.py:191
msgid "Noise suppression could not start, so it was turned off."
msgstr "A supressão de ruído não conseguiu iniciar e foi desligada."

#: src/gf63_mic_fix/ui/uninstall.py:30
msgid "Nothing to uninstall"
msgstr "Nada para desinstalar"

#: src/gf63_mic_fix/ui/uninstall.py:31
msgid "This copy runs from the source code. Use “Fix active” to undo the fix."
msgstr "Esta cópia roda a partir do código-fonte. Use “Correção ativa” para desfazer a correção."

#: src/gf63_mic_fix/ui/uninstall.py:32 src/gf63_mic_fix/ui/uninstall.py:67
#: src/gf63_mic_fix/ui/window.py:337
msgid "OK"
msgstr "OK"

#: src/gf63_mic_fix/ui/uninstall.py:35
msgid "Your password will be asked to remove the program."
msgstr "Sua senha será pedida para remover o programa."

#: src/gf63_mic_fix/ui/uninstall.py:37
msgid "Uninstall GF63 Mic Fix?"
msgstr "Desinstalar o GF63 Mic Fix?"

#: src/gf63_mic_fix/ui/uninstall.py:38
msgid ""
"The microphone goes back to how it was before the fix, and the program is "
"removed."
msgstr "O microfone volta a ser como era antes da correção, e o programa é removido."

#: src/gf63_mic_fix/ui/uninstall.py:40 src/gf63_mic_fix/ui/window.py:316
msgid "Cancel"
msgstr "Cancelar"

#: src/gf63_mic_fix/ui/uninstall.py:40
msgid "Uninstall"
msgstr "Desinstalar"

#: src/gf63_mic_fix/ui/uninstall.py:58
#, fuzzy
msgid "GF63 Mic Fix was removed"
msgstr "O GF63 Mic Fix foi atualizado"

#: src/gf63_mic_fix/ui/uninstall.py:59
msgid "The microphone settings were restored. Thank you for using it."
msgstr "As configurações do microfone foram restauradas. Obrigado por usar."

#: src/gf63_mic_fix/ui/uninstall.py:60
msgid "Close"
msgstr "Fechar"

#: src/gf63_mic_fix/ui/uninstall.py:65
msgid "The program was not removed"
msgstr "O programa não foi removido"

#: src/gf63_mic_fix/ui/uninstall.py:66
msgid ""
"The fix was turned off, but removing the program was cancelled or failed."
msgstr "A correção foi desligada, mas a remoção do programa foi cancelada ou falhou."

