# Maintainer: junior9283 <eng.geraldo@outlook.com>
# Generated by packaging/build.sh from PKGBUILD.in; published with each release.
pkgname=gf63-mic-fix
pkgver=@VERSION@
pkgrel=1
pkgdesc="Fix the noisy internal microphone of MSI GF63 Thin laptops"
arch=('any')
url="https://github.com/junior9283/gf63-mic-fix"
license=('GPL-3.0-or-later')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita' 'pipewire' 'pipewire-pulse' 'libpulse'
         'wireplumber' 'gnupg' 'polkit')
optdepends=('noise-suppression-for-voice: removes fan and keyboard noise')
source=("$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('@SHA256@')

package() {
    cd "$pkgname-$pkgver"
    local id=io.github.junior9283.Gf63MicFix
    install -d "$pkgdir/usr/share/$pkgname"
    cp -R app/. "$pkgdir/usr/share/$pkgname/"
    echo arch >"$pkgdir/usr/share/$pkgname/install-type"
    install -Dm755 bin/gf63-mic-fix "$pkgdir/usr/bin/gf63-mic-fix"
    # Same path as the rpm/deb: the app and the polkit policy refer to it.
    install -Dm755 data/gf63-mic-fix-uninstall "$pkgdir/usr/libexec/gf63-mic-fix-uninstall"
    install -Dm644 data/gf63-mic-fix.service data/gf63-mic-fix-update.service \
        data/gf63-mic-fix-update.timer -t "$pkgdir/usr/lib/systemd/user/"
    install -Dm644 data/io.github.junior9283.gf63micfix.policy -t "$pkgdir/usr/share/polkit-1/actions/"
    install -Dm644 "data/$id.desktop" "data/$id.Uninstall.desktop" -t "$pkgdir/usr/share/applications/"
    install -Dm644 "data/$id.svg" -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
    install -Dm644 "data/$id.metainfo.xml" -t "$pkgdir/usr/share/metainfo/"
}
